# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GovHub BR database connection via Apache Airflow PostgreSQL
GOVHUB_DATABASE_URL="postgres://postgres:postgres@host.docker.internal:5432/postgres"


GROQ_API_KEY="your_groq_api_key_here"

# ─────────────────────────────────────────────
# E-MAIL / SMTP (Nodemailer)
# Deixe em branco para usar modo simulação (e-mails aparecem no console)
# ─────────────────────────────────────────────

# Servidor SMTP (ex: Exchange MTE = smtp.office365.com | Gmail = smtp.gmail.com)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"                    # true para porta 465, false para 587 (STARTTLS)
SMTP_USER="orbita@trabalho.gov.br"
SMTP_PASS="sua_senha_smtp_aqui"
SMTP_FROM="ORBITA.AECI <noreply@trabalho.gov.br>"

# E-mail do administrador que recebe notificações de novos pedidos de acesso
ADMIN_NOTIFICATION_EMAIL="alessandro.lourenco@trabalho.gov.br"
